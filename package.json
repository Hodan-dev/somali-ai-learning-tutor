{
  "name": "somali-ai-learning-tutor",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "concurrently -n server,client -c teal,magenta \"npm run dev --prefix server\" \"npm run dev --prefix client\"",
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "build": "npm run build --prefix client",
    "start": "npm run start --prefix server",
    "start:fast": "npm run build --prefix client && npm run start --prefix server",
    "db": "docker compose up -d mongo",
    "db:stop": "docker compose down",
    "db:logs": "docker compose logs -f mongo",
    "pptx": "node docs/presentation/generate.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "pptxgenjs": "^3.12.0"
  }
}
